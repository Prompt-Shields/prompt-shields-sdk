{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptshields.com/schemas/route-policy/vectors.schema.json",
  "title": "Golden decision vectors for route-policy.v1",
  "description": "A vector file names one example policy and lists requests with the decision every implementation must reach. Runners compare only the fields present in 'expected'. A vector with status 'pending' covers behavior no implementation has yet; runners must skip it visibly, citing pending_reason, and never count it as passed.",
  "type": "object",
  "required": ["policy", "vectors"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "policy": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Name of a policy in schemas/route-policy/examples/ (without .json)."
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/vector" }
    }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "required": ["id", "request", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "description": { "type": "string" },
        "status": { "enum": ["active", "pending"], "default": "active" },
        "pending_reason": { "type": "string", "minLength": 1 },
        "request": { "$ref": "#/$defs/request" },
        "expected": { "$ref": "#/$defs/expected" }
      }
    },
    "request": {
      "type": "object",
      "required": ["messages"],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "default": "auto",
          "description": "Requested model ('auto' or a concrete name)."
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": { "type": "string" },
              "content": { "type": "string" }
            }
          }
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "Output bound used for cost estimation. Omitted means 512."
        },
        "approx_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Overrides the input-token estimate (ceil(total content chars / 4)). Lets a vector state a long input without carrying it."
        },
        "hints": {
          "type": "object",
          "additionalProperties": false,
          "description": "SDK RouteHint fields. On the wire: quality -> X-PS-Quality, max_cost -> X-PS-Max-Cost, model_group -> X-PS-Route.",
          "properties": {
            "quality": { "enum": ["draft", "balanced", "critical"] },
            "max_cost": { "type": "number", "minimum": 0 },
            "model_group": { "type": "string", "minLength": 1 }
          }
        },
        "data_classification": {
          "type": "string",
          "description": "Declared sensitivity level (X-PS-Data-Classification)."
        },
        "pii_detected": {
          "type": "array",
          "items": { "type": "string" },
          "description": "PII categories the detector reported. Given as input so vectors do not depend on a detector."
        },
        "use_case": { "type": "string" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "model": { "type": "string" },
        "group": { "type": "string" },
        "reason": { "type": "string" },
        "est_cost": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated USD cost; compared with a relative tolerance of 1e-9."
        },
        "sensitivity_level": { "type": "string" },
        "sensitivity_source": {
          "enum": ["declared", "pii_escalated", "default"]
        },
        "error": {
          "enum": ["PolicyViolation"],
          "description": "The call must fail with this error instead of routing."
        }
      }
    }
  }
}

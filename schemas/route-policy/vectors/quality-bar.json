{
  "$schema": "../vectors.schema.json",
  "description": "Per-use-case quality bar: min_group raises the group a hint or strategy would pick (by group_order); eval_set eligibility limits candidates to eligible_models. Both apply after the data policy.",
  "policy": "nordic-sovereign",
  "vectors": [
    {
      "id": "min-group-raises-draft",
      "request": {
        "messages": [{ "role": "user", "content": "hi" }],
        "max_tokens": 100,
        "data_classification": "internal",
        "use_case": "legal-review",
        "hints": { "quality": "draft" }
      },
      "expected": {
        "model": "claude-sonnet-4-20250514",
        "group": "frontier"
      }
    },
    {
      "id": "min-group-applies-on-transparent-path",
      "request": {
        "messages": [{ "role": "user", "content": "hi" }],
        "max_tokens": 100,
        "data_classification": "internal",
        "use_case": "legal-review"
      },
      "expected": {
        "model": "claude-sonnet-4-20250514",
        "group": "frontier"
      }
    },
    {
      "id": "eval-set-limits-to-eligible-models",
      "description": "scaleway-small is compliant and cheaper but has not passed claims-v3.",
      "request": {
        "messages": [{ "role": "user", "content": "hi" }],
        "max_tokens": 100,
        "data_classification": "confidential",
        "use_case": "claim-summary",
        "hints": { "quality": "draft" }
      },
      "expected": {
        "model": "mistral-small-eu",
        "group": "cheap"
      }
    },
    {
      "id": "unknown-use-case-has-no-bar",
      "request": {
        "messages": [{ "role": "user", "content": "hi" }],
        "max_tokens": 100,
        "data_classification": "internal",
        "use_case": "chit-chat",
        "hints": { "quality": "draft" }
      },
      "expected": {
        "model": "scaleway-small",
        "group": "cheap"
      }
    }
  ]
}

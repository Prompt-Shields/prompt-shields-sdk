      "usage": { "usage_units": 2000, "usage_unit_type": "characters" },
      "expected_cost": null,
      "derivation": "gpt-4o-mini-tts bills text and audio tokens, not characters: a character count has no exact price, so the call is unmetered"
    },
    {

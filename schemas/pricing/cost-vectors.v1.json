      "usage": { "usage_units": 1000, "usage_unit_type": "characters" },
      "expected_cost": null,
      "derivation": "ElevenLabs text-to-speech list prices could not be confirmed (vendor page and LiteLLM disagree), so the call is unmetered"
    },
    {
      "id": "openai-gpt-4o-mini-tts-characters-unpriced",
      "dimension": "usage_units",
      "vendor": "openai",

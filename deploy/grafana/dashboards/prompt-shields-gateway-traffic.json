{
  "uid": "ps-gateway-traffic",
  "title": "Prompt Shields / Gateway traffic",
  "description": "Requests, errors, latency, tokens, cost, budgets, streams and MCP tool calls from the gateway's /metrics (PS_METRICS_ENABLED=true).",
  "tags": [
    "prompt-shields",
    "gateway"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "prompt-shields"
      ],
      "asDropdown": true,
      "title": "Prompt Shields",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(ps_gateway_requests_total, provider)",
          "refId": "provider-var"
        },
        "definition": "label_values(ps_gateway_requests_total, provider)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": []
      },
      {
        "name": "business_unit",
        "label": "Business unit",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(ps_gateway_requests_total, business_unit)",
          "refId": "business_unit-var"
        },
        "definition": "label_values(ps_gateway_requests_total, business_unit)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": []
      },
      {
        "name": "mcp_server",
        "label": "MCP server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(ps_gateway_mcp_tool_calls_total, server)",
          "refId": "mcp_server-var"
        },
        "definition": "label_values(ps_gateway_mcp_tool_calls_total, server)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []

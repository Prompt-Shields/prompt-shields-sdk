        },
        "ps.pii.category": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "description": "Category as the check reports it, 'unspecified' or 'other'. Never a value."
        },
        "ps.pii.count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "@timestamp",
        "ps.schema_version",
        "event.id",
        "event.name",
        "event.kind",
        "event.category",
        "event.outcome",
        "log.logger",
        "service.name",
        "vendor_product",
        "severity",
        "action",
        "signature",
        "ps.request_id",
        "http.route",
        "http.request.method",
        "ps.guardrail.hook_id",
        "ps.guardrail.hook_type",
        "ps.guardrail.check_id",

{
  "ruleset": "eu_ai_act_annex_iii",
  "version": "1.0.0",
  "framework": "EU_AI_ACT",
  "title": "EU AI Act Annex III high-risk use cases",
  "description": "Suggests the Annex III area an AI asset may fall under, from its use case, business unit, calling service, data sources, output destinations and detected PII. Annex III systems are high-risk under Article 6(2) unless the Article 6(3) derogation applies; the engine does not assess that derogation, so every match is a suggestion for a human to confirm or reject.",
  "lists": {
    "biometric_pii": ["biometric", "biometric_data", "face", "face_image", "facial_image", "fingerprint", "iris", "voiceprint", "voice_print"],
    "hr_units": ["hr", "human resources", "people", "people ops", "people operations", "talent", "talent acquisition", "recruiting", "recruitment", "workforce"],
    "education_units": ["education", "school*", "universit*", "academic*", "admissions", "registrar", "student*"],
    "finance_units": ["lending", "loans", "credit", "underwriting", "retail banking", "consumer finance"],
    "insurance_units": ["insurance", "underwriting", "actuarial"],
    "public_sector_units": ["social services", "welfare", "public health"],
    "health_pii": ["health", "medical", "medical_record", "diagnosis", "health_insurance_id"],
    "financial_pii": ["credit_card", "bank_account", "iban", "income", "salary", "credit_score", "tax_id"],
    "identity_pii": ["national_id", "ssn", "passport", "date_of_birth", "drivers_license"]
  },
  "rules": [
    {
      "id": "eu_ai_act.annex_iii.1a.remote_biometric_identification",
      "category": "biometrics",
      "level": "high",
      "reference": "Annex III, point 1(a)",
      "title": "Remote biometric identification",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["biometric identification", "remote biometric*", "facial recognition", "face recognition", "face identification", "face search", "face matching", "speaker identification", "voice identification", "gait recognition"]}
        ]
      },
      "supporting": [
        {"signal": "pii_types", "any_of": "@biometric_pii"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.1b.biometric_categorisation",
      "category": "biometrics",
      "level": "high",
      "reference": "Annex III, point 1(b)",
      "title": "Biometric categorisation by sensitive or protected attributes",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["biometric categori*", "ethnicity detection", "ethnicity classification", "facial attribute*", "face attribute*"]}
        ]
      },
      "supporting": [
        {"signal": "pii_types", "any_of": "@biometric_pii"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.1c.emotion_recognition",
      "category": "biometrics",
      "level": "high",
      "reference": "Annex III, point 1(c)",
      "title": "Emotion recognition",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["emotion recognition", "emotion detection", "affect recognition", "affective computing", "facial expression analysis"]}
        ]
      },
      "supporting": [
        {"signal": "pii_types", "any_of": "@biometric_pii"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.2.critical_infrastructure",
      "category": "critical_infrastructure",
      "level": "high",
      "reference": "Annex III, point 2",
      "title": "Safety component in critical infrastructure (digital infrastructure, road traffic, water, gas, heating, electricity)",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["critical infrastructure", "power grid", "electricity grid", "grid operation*", "grid control", "water supply", "water treatment", "gas supply", "gas pipeline*", "district heating", "heating supply", "road traffic", "traffic control", "traffic management", "scada", "substation*"]}
        ]
      },
      "supporting": [
        {"signal": "business_unit", "keywords": ["utilities", "grid operations", "energy", "transport*"]}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.3a.education_access",
      "category": "education",
      "level": "high",
      "reference": "Annex III, point 3(a)",
      "title": "Access or admission to education and vocational training",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["admission*", "student application*", "student enrol*", "university application*", "school placement"]}
        ]
      },
      "supporting": [
        {"signal": "business_unit", "keywords": "@education_units"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.3b.learning_outcomes",
      "category": "education",
      "level": "high",
      "reference": "Annex III, point 3(b)",
      "title": "Evaluating learning outcomes",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["grading", "auto grading", "autograd*", "essay scoring", "exam scoring", "exam marking", "learning outcome*", "student assessment*", "student evaluation*", "homework grading"]}
        ]
      },
      "supporting": [
        {"signal": "business_unit", "keywords": "@education_units"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.3c.education_level",
      "category": "education",
      "level": "high",
      "reference": "Annex III, point 3(c)",
      "title": "Assessing the appropriate level of education for an individual",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["placement test*", "course placement", "level placement", "education level assessment"]}
        ]
      },
      "supporting": [
        {"signal": "business_unit", "keywords": "@education_units"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.3d.test_proctoring",
      "category": "education",
      "level": "high",
      "reference": "Annex III, point 3(d)",
      "title": "Monitoring and detecting prohibited behaviour of students during tests",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["proctor*", "exam monitoring", "test monitoring", "cheating detection", "exam integrity"]}
        ]
      },
      "supporting": [
        {"signal": "business_unit", "keywords": "@education_units"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.4a.recruitment",
      "category": "employment",
      "level": "high",
      "reference": "Annex III, point 4(a)",
      "title": "Recruitment or selection: targeted job ads, filtering applications, evaluating candidates",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["recruit*", "hiring", "resume*", "cv screening", "cv parsing", "candidate*", "applicant*", "job application*", "talent acquisition", "job ad*", "job posting*", "interview screening", "interview scoring", "interview analysis"]},
          {"signal": "data_sources", "keywords": ["ats", "applicant tracking*"]},
          {"signal": "business_unit", "keywords": ["talent acquisition", "recruiting", "recruitment"], "strength": "weak"}
        ]
      },
      "supporting": [
        {"signal": "business_unit", "keywords": "@hr_units"},
        {"signal": "pii_types", "any_of": "@identity_pii"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.4b.workforce_management",
      "category": "employment",
      "level": "high",
      "reference": "Annex III, point 4(b)",
      "title": "Decisions on promotion or termination, task allocation, monitoring or evaluating workers",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["performance review*", "performance evaluation*", "employee performance", "employee monitoring", "worker monitoring", "workforce analytics", "promotion decision*", "termination decision*", "dismissal*", "task allocation", "shift allocation", "productivity monitoring", "employee scoring", "attrition prediction", "flight risk"]}
        ]
      },
      "supporting": [
        {"signal": "business_unit", "keywords": "@hr_units"},
        {"signal": "pii_types", "any_of": "@identity_pii"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.5a.public_benefits",
      "category": "essential_services",
      "level": "high",
      "reference": "Annex III, point 5(a)",
      "title": "Eligibility for public assistance benefits and services, including healthcare",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["benefit eligibility", "benefits eligibility", "eligibility assessment*", "eligibility determination*", "welfare", "social benefit*", "public assistance", "social security", "unemployment benefit*", "housing benefit*", "medicaid", "healthcare eligibility"]},
          {"signal": "business_unit", "keywords": "@public_sector_units", "strength": "weak"}
        ]
      },
      "supporting": [
        {"signal": "pii_types", "any_of": "@identity_pii"},
        {"signal": "pii_types", "any_of": "@health_pii"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.5b.creditworthiness",
      "category": "essential_services",
      "level": "high",
      "reference": "Annex III, point 5(b)",
      "title": "Creditworthiness evaluation or credit scoring (fraud detection excluded)",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["credit scor*", "creditworth*", "credit risk", "credit decision*", "loan approval*", "loan underwriting", "loan application*", "lending decision*", "credit limit*"]},
          {"signal": "business_unit", "keywords": "@finance_units", "strength": "weak"}
        ]
      },
      "unless": [
        {"signal": "text", "keywords": ["fraud*"]}
      ],
      "supporting": [
        {"signal": "pii_types", "any_of": "@financial_pii"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.5c.life_health_insurance",
      "category": "essential_services",
      "level": "high",
      "reference": "Annex III, point 5(c)",
      "title": "Risk assessment and pricing for life and health insurance",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["life insurance", "health insurance", "medical underwriting"]},
          {"signal": "text", "keywords": ["insurance underwriting", "insurance pricing", "premium pricing", "premium calculation*"], "strength": "weak"}
        ]
      },
      "supporting": [
        {"signal": "business_unit", "keywords": "@insurance_units"},
        {"signal": "pii_types", "any_of": "@health_pii"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.5d.emergency_response",
      "category": "essential_services",
      "level": "high",
      "reference": "Annex III, point 5(d)",
      "title": "Evaluating emergency calls, dispatching emergency services, emergency patient triage",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["emergency call*", "emergency dispatch", "ambulance dispatch", "police dispatch", "fire dispatch", "emergency services", "first responder*", "patient triage", "emergency triage", "medical triage"]}
        ]
      },
      "supporting": [
        {"signal": "pii_types", "any_of": "@health_pii"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.6.law_enforcement",
      "category": "law_enforcement",
      "level": "high",
      "reference": "Annex III, point 6",
      "title": "Law enforcement: victim or offending risk, polygraphs, evidence reliability, profiling",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["law enforcement", "police", "policing", "crime prediction", "predictive policing", "recidivism", "reoffend*", "re offend*", "criminal risk", "offender profiling", "suspect identification", "evidence analysis", "evidence reliability", "polygraph*", "lie detection", "criminal investigation*", "victim risk"]}
        ]
      },
      "supporting": [
        {"signal": "pii_types", "any_of": "@identity_pii"},
        {"signal": "pii_types", "any_of": "@biometric_pii"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.7.migration_border",
      "category": "migration_border_control",
      "level": "high",
      "reference": "Annex III, point 7",
      "title": "Migration, asylum and border control management",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["asylum", "visa application*", "visa processing", "residence permit*", "immigration", "border control", "border security", "irregular migration", "migration risk"]}
        ]
      },
      "supporting": [
        {"signal": "pii_types", "any_of": "@identity_pii"},
        {"signal": "pii_types", "any_of": "@biometric_pii"}
      ]
    },
    {
      "id": "eu_ai_act.annex_iii.8a.administration_of_justice",
      "category": "justice_democratic_processes",
      "level": "high",
      "reference": "Annex III, point 8(a)",
      "title": "Assisting a judicial authority in researching and interpreting facts and law, or alternative dispute resolution",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["judicial", "court ruling*", "court decision*", "sentencing", "adjudicat*", "dispute resolution", "arbitration"]}
        ]
      }
    },
    {
      "id": "eu_ai_act.annex_iii.8b.elections",
      "category": "justice_democratic_processes",
      "level": "high",
      "reference": "Annex III, point 8(b)",
      "title": "Influencing the outcome of an election or referendum, or voting behaviour",
      "when": {
        "any": [
          {"signal": "text", "keywords": ["election*", "electoral", "voter*", "referendum*", "political campaign*", "political advertising"]},
          {"signal": "text", "keywords": ["voting"], "strength": "weak"}
        ]
      }
    }
  ]
}

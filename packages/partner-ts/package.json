{
  "name": "@prompt-shields/partner",
  "version": "0.1.0",
  "description": "TypeScript client for the Prompt Shields Partner API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prompt-Shields/prompt-shields-sdk.git",
    "directory": "packages/partner-ts"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "check:openapi": "jest test/openapi.test.ts",
    "check:version": "node scripts/check-version.js",
    "prepublishOnly": "npm run check:version && npm run build && npm test"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.8.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "typescript": "^5.3.3",
    "yaml": "2.8.4"
  }
}
